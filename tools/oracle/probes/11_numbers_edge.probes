// Number edge cases: non-finite values, subnormals, toFixed, round, parseNumber, seeded random.
## num2.str_misc
[str 123456, str 0.0001, str -0, str 3.4e38, str 100000, str 999999.5, str (1/3), str (2/3)]
## num2.str_precision
[str 16777215, str 999999, str 9999995, str 0.000123456, str 123456789, str 1.5e-7]
## num2.str_subnormal
[str 1e-38, str 1e-45, str -1e-39, str 1.17549e-38, str 1.2e-38]
## num2.subnormal_math
[str (1e-30 * 1e-10), (1e-30 * 1e-10) == 0, 1e-39 == 0, 1e-39 isEqualTo 0, str (1.2e-38 / 2), 1e-39 * 1e30]
## num2.nonfinite_text
[str (-(1/0)), str (0 * (1/0)), str (-(sqrt -1)), str ((1/0) - (1/0)), str [1/0], format ["%1", 1/0]]
## num2.nonfinite_types
[typeName (sqrt -1), typeName 1e39, typeName ([1/0] select 0), (1/0) isEqualType 0, typeName (abs (1/0))]
## num2.nonfinite_compare
[1e39 == 1e39, (1/0) > 5, (sqrt -1) == (sqrt -1), (sqrt -1) < 1, (sqrt -1) > 1, (sqrt -1) != 1, (sqrt -1) >= 1]
## num2.nonfinite_equal
[(1/0) isEqualTo (1/0), [1/0] isEqualTo [1/0], (sqrt -1) isEqualTo (sqrt -1), [1/0] isEqualTypeAll 0]
## num2.minmax_nan
[str ((1/0) * 0), str ((1/0) min 3), str ((sqrt -1) max 3), str (3 max (sqrt -1)), str ((sqrt -1) min 3), str (3 min (sqrt -1))]
## num2.minmax_inf
[(1/0) max 3, 3 max (1/0), -(1/0) min 3]
## num2.tofixed_ties
[1e6 toFixed 2, 1.005 toFixed 2, 0.5 toFixed 0, 1.5 toFixed 0, 2.5 toFixed 0, -0.5 toFixed 0, 0.125 toFixed 2, 0.375 toFixed 2]
## num2.tofixed_wide
[123.456 toFixed 20, 1 toFixed 25, 1e30 toFixed 2, 1 toFixed 2.5, 1 toFixed 3.5, 1e38 toFixed 20]
## num2.tofixed_negative_digits
[1 toFixed -1, 1.25 toFixed -3]
## num2.tofixed_inf_fails
str ((1/0) toFixed 2)
## num2.tofixed_unary_script
call {toFixed 2}; str 1.5
## num2.tofixed_unary_reset
private _r = [str 1.5]; toFixed 3; _r pushBack str 1.5; call {toFixed -1}; _r pushBack str 1.5; _r
## num2.tofixed_unary_nonfinite
toFixed 2; [str (sqrt -1), str (1/0), str 1e30]
## num2.round_cases
[round 0.5, round 1.5, round 2.5, round -0.5, round -1.5, round 0.49999997, round 8388609, round -0.4, round 0.4, round -2.5000002, round 1e10]
## num2.round_signs
[str round -0.4, str round -0.0, str floor -0.5, str ceil -0.5, str ceil -0.0, str (-0 + 0), str (0 * -1)]
## num2.neg_zero_ops
[str (-0), str (0 - 0), str (-0 - 0), str (-0 + -0), str (abs -0), str (-0 * 5), str (0 / -5), str (sqrt -0)]
## num2.linear_conversion_degenerate
[linearConversion [5,5,5,0,1], linearConversion [5,5,7,0,1], linearConversion [5,5,7,0,1,true], linearConversion [0,10,5,1,1], linearConversion [5,5,3,0,1], linearConversion [5,5,5,0,1,true]]
## num2.linear_conversion_clamp
[linearConversion [0,10,15,0,1,true], linearConversion [0,10,-5,1,0,true], linearConversion [0,10,15,1,0,true], linearConversion [10,0,2,0,1]]
## num2.parse_specials
[parseNumber "inf", parseNumber "nan", parseNumber "1.#INF", parseNumber "-1e40", parseNumber "  12abc", parseNumber "0x10", parseNumber "1e", parseNumber ".5", parseNumber "-.5e1", parseNumber "", parseNumber "abc"]
## num2.parse_special_types
[typeName parseNumber "inf", typeName parseNumber "nan", str parseNumber "-abc", str parseNumber "-0", parseNumber "1e-40"]
## num2.literals
[0x10, 0xFF, 1e3, 1.5e-2, $10, 1.]
## num2.mod_neg
[-5 % 3, 5 % -3, -5 mod 3, 5.5 % 2, -0.5 % 1]
## num2.pow
[2 ^ 0.5, (-2) ^ 2, (-2) ^ 3, 0 ^ 0, 0 ^ -1, (-8) ^ (1/3)]
## num2.trig
[sin 30, cos 60, tan 45, asin 0.5, acos 0.5, atan 1, 1 atan2 1, -1 atan2 -1, 0 atan2 0, sin 180, cos 90, tan 90]
## num2.trig_domain
[asin 2, acos 2, ln 0, ln -1, log 0, exp 100, sqrt -4, deg 1, rad 180, exp 1, ln 10, log 1000]
## num2.floor_ceil
[floor 1e10, ceil -1e10, floor -2.5, ceil 2.0000002, floor (sqrt -1), ceil (1/0)]
## num2.params_nan
[1/0] params [["_a", 0, [0]]]
## num2.format_numbers
[format ["%1", 0.1], format ["%1", [1e7]], format ["%1", 123456789]]
## rnd.seeded_noise_2d
[5 random [1, 2], 0 random [0, 0], 12 random [3.5, -2], -3 random [100, 200]]
## rnd.seeded_noise_bad_count
[1 random [1, 2, 3], 2]
## rnd.seeded_inf_seed
(1/0) random 1
## rnd.seeded_nan_max
str (5 random (sqrt -1))
