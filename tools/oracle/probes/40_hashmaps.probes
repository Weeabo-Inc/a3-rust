{_y > 1} count createHashMapFromArray [["a", 1], ["b", 2], ["c", 3]]
## hash.merge
private _h = createHashMapFromArray [["a", 1]]; _h merge createHashMapFromArray [["a", 9], ["b", 2]]; [_h get "a", _h get "b"]
