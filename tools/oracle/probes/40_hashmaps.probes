keys createHashMapFromArray [["b", 1], ["a", 2], ["c", 3], ["d", 4], ["e", 5]]
## hash.str_order
str createHashMapFromArray [["x", 1], ["y", 2], ["z", 3]]
## hash.str_one
str createHashMapFromArray [["k", [1, "v"]]]
## hash.foreach_vars
private _r = []; {_r pushBack [_x, _y]} forEach createHashMapFromArray [["a", 1]]; _r
