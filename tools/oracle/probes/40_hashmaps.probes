private _h = createHashMap; _h set [1, "one"]; [_h get 1, _h get 1.0, _h get "1"]
## hash.array_key
private _h = createHashMap; _h set [[1, 2], "x"]; _h get [1, 2]
## hash.bool_key
private _h = createHashMap; _h set [true, 1]; _h get true
## hash.side_key
private _h = createHashMap; _h set [west, 1]; _h get west
## hash.get_missing
private _h = createHashMap; isNil {_h get "x"}
