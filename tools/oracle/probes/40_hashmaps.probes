private _h = createHashMap; _h getOrDefault ["x", 5, true]; _h get "x"
## hash.getordefaultcall
private _h = createHashMap; [_h getOrDefaultCall ["x", {7}, true], _h get "x"]
## hash.set_returns
private _h = createHashMap; typeName (_h set ["a", 1])
## hash.set_insert_only
private _h = createHashMap; _h set ["a", 1]; [_h set ["a", 2, true], _h get "a"]
