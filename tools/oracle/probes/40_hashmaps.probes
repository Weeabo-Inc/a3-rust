private _h = createHashMapFromArray [["a", 1]]; _h merge [createHashMapFromArray [["a", 9]], true]; _h get "a"
## hash.copy_plus
private _h = createHashMapFromArray [["a", [1]]]; private _c = +_h; (_c get "a") pushBack 2; _h get "a"
