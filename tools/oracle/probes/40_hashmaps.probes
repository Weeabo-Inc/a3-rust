// HashMaps: creation, keys, get/set, case sensitivity, key types, iteration order.
## hash.create_empty
str createHashMap
## hash.typename
typeName createHashMap
## hash.from_array
private _h = createHashMapFromArray [["a", 1], ["b", 2]]; [_h get "a", _h get "b", count _h]
## hash.from_two_arrays
private _h = ["a", "b"] createHashMapFromArray [1, 2]; [_h get "a", _h get "b"]
## hash.from_two_arrays_short
