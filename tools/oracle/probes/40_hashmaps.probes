private _h = createHashMapFromArray [["a", 1]]; [_h deleteAt "a", count _h, _h deleteAt "a"]
## hash.keys_sorted
private _h = createHashMapFromArray [["b", 1], ["a", 2], ["c", 3]]; private _k = keys _h; _k sort true; _k
## hash.values_sorted
private _h = createHashMapFromArray [["b", 1], ["a", 2], ["c", 3]]; private _v = values _h; _v sort true; _v
