[true and false, true or false]
## type.compile_str
call compile "1 + 2"
## type.compile_empty
typeName compile ""
## type.str_compile_empty
str compile ""
## type.call_args
[1, 2] call {_this select 1}
## type.call_nil_args
typeName (call {_this})
## type.this_in_spawned
isNil "_this"
## type.private_scope
private _a = 1; call {private _a = 2}; _a
## type.nonprivate_scope
private _a = 1; call {_a = 2}; _a
## type.private_array
private ["_x1"]; _x1 = 5; _x1
## type.global_var
a3ro_g = 5; private _r = a3ro_g; a3ro_g = nil; _r
## type.setvariable_get
missionNamespace setVariable ["a3ro_v", 3]; private _r = missionNamespace getVariable "a3ro_v"; missionNamespace setVariable ["a3ro_v", nil]; _r
## type.getvariable_default
missionNamespace getVariable ["a3ro_undefined_variable", "def"]
## type.getvariable_case
missionNamespace setVariable ["A3RO_Case", 1]; private _r = missionNamespace getVariable "a3ro_case"; A3RO_Case = nil; _r
## type.allvariables_case
a3ro_mixedCase = 1; private _r = "a3ro_mixedcase" in allVariables missionNamespace; a3ro_mixedCase = nil; _r
