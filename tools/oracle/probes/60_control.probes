// Control flow, params, error behaviour.
## ctl.if_no_else
if (false) then {1}
## ctl.if_else
if (false) then {1} else {2}
## ctl.if_array
if (true) then [{1}, {2}]
## ctl.if_number_cond
if (1) then {1} else {2}
## ctl.exitwith
private _r = 0; call {if (true) exitWith {_r = 1}; _r = 2}; _r
## ctl.exitwith_value
call {if (true) exitWith {5}; 6}
## ctl.switch
switch (2) do {case 1: {"a"}; case 2: {"b"}; default {"c"}}
## ctl.switch_default
switch (9) do {case 1: {"a"}; default {"c"}}
## ctl.switch_nomatch
switch (9) do {case 1: {"a"}}
## ctl.switch_fallthrough
switch (1) do {case 1; case 2: {"x"}}
## ctl.switch_string_case
switch ("A") do {case "a": {"lower"}; case "A": {"upper"}}
## ctl.for_step
private _r = []; for "_i" from 0 to 10 step 3 do {_r pushBack _i}; _r
## ctl.for_reverse
private _r = []; for "_i" from 3 to 1 step -1 do {_r pushBack _i}; _r
## ctl.for_float
private _r = []; for "_i" from 0 to 1 step 0.25 do {_r pushBack _i}; _r
## ctl.for_empty
private _r = []; for "_i" from 1 to 0 do {_r pushBack _i}; _r
## ctl.for_array
private _r = []; for [{private _i = 0}, {_i < 3}, {_i = _i + 1}] do {_r pushBack _i}; _r
## ctl.for_return
for "_i" from 1 to 3 do {_i * 2}
## ctl.while_return
private _i = 0; while {_i < 3} do {_i = _i + 1; _i * 10}
## ctl.count_return
typeName ({true} forEach [])
## ctl.foreach_empty
isNil {{1} forEach []}
## ctl.try_catch
try {throw "boom"} catch {_exception}
## ctl.try_nothrow
try {5} catch {6}
## ctl.throw_array
try {throw [1, 2]} catch {_exception select 1}
## ctl.breakout
scopeName "outer"; private _r = 0; {if (_x == 2) then {_r = _x; breakOut "outer"}} forEach [1, 2, 3]; _r
## ctl.breakto_value
call {scopeName "s"; {if (_x > 1) then {_x breakOut "s"}} forEach [1, 2, 3]; 0}
## ctl.continue
private _r = []; {if (_x == 2) then {continue}; _r pushBack _x} forEach [1, 2, 3]; _r
## ctl.break_loop
private _r = []; {if (_x == 2) then {break}; _r pushBack _x} forEach [1, 2, 3]; _r
## ctl.continuewith
[1, 2, 3] apply {if (_x == 2) then {continueWith 0}; _x}
## ctl.exitwith_foreach
private _r = 0; {if (_x == 2) exitWith {_r = _x}} forEach [1, 2, 3]; _r
## ctl.params_basic
[1, "a"] call {params ["_a", "_b"]; [_a, _b]}
## ctl.params_default
[1] call {params ["_a", ["_b", 7]]; [_a, _b]}
## ctl.params_type_ok
[1] call {params [["_a", 0, [0]]]; _a}
## ctl.params_type_bad
["x"] call {params [["_a", 0, [0]]]; _a}
## ctl.params_return
[1] call {params [["_a", 0, [0]]]}
## ctl.params_return_bad
["x"] call {params [["_a", 0, [0]]]}
## ctl.params_count_bad
[[1, 2, 3]] call {params [["_a", [], [[]], 2]]; _a}
## ctl.params_count_ok
[[1, 2]] call {params [["_a", [], [[]], 2]]; _a}
## ctl.params_nil_default
[nil] call {params [["_a", 5]]; _a}
## ctl.params_scalar_this
5 call {params ["_a"]; _a}
## ctl.params_skip
[1, 2, 3] call {params ["", "_b"]; _b}
## ctl.params_missing
[] call {params ["_a"]; isNil "_a"}
## ctl.params_bad_name
[1] call {params ["a"]; 1}
## ctl.params_count_array
[[1, 2]] call {params [["_a", [], [[]], [1, 3]]]; _a}
## ctl.param_cmd
[1, "x"] param [1, 0, [0]]
## ctl.error_undefined_var
a3ro_undefined_variable + 1
## ctl.error_type
"a" + 1
## ctl.error_zero_div
1 / 0
## ctl.error_select_neg
[1, 2] select -1
## ctl.error_missing_semicolon
call compile "1 2"
## ctl.error_continue_after
private _r = 1; isNil {_r = 1 + "x"}; _r
## ctl.waituntil_immediate
waitUntil {true}; 1
## ctl.sleep_zero
sleep 0; 2
## ctl.caninterrupt
canSuspend
## ctl.isnil_unscheduled
private _r = false; isNil {_r = canSuspend}; _r
## ctl.call_unscheduled
call {canSuspend}
## ctl.spawn_typename
typeName ([] spawn {})
## ctl.with_namespace
with uiNamespace do {a3ro_ui = 1}; private _r = uiNamespace getVariable "a3ro_ui"; uiNamespace setVariable ["a3ro_ui", nil]; _r
## ctl.isequalto_this
[1, 2] call {_this isEqualTo [1, 2]}
## ctl.scopename_return
call {scopeName "x"; 1}
## ctl.nested_exitwith_return
[1, 2, 3] apply {if (_x > 1) exitWith {0}; _x}
## ctl.select_code_index
[1, 2, 3] select {_forEachIndex > 0}
## ctl.count_code_bool_required
{1} count [1, 2]
