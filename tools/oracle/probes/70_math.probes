## rnd.seeded_basic
12345 random 100
## rnd.seeded_same
[42 random 1, 42 random 1]
## rnd.seeded_zero
0 random 1
## rnd.seeded_neg
-5 random 10
## rnd.seeded_float_seed
1.5 random 1
## rnd.seeded_array
[1, 2] random 1
## rnd.seeded_noise
[3, 4, 5] random 1
## rnd.seeded_series
private _r = []; for "_i" from 0 to 4 do {_r pushBack (_i random 1)}; _r
## rnd.seeded_big
1000000 random 1
## rex.match_true
"abc123" regexMatch "[a-z]+[0-9]+"
## rex.match_partial
"abc123" regexMatch "[a-z]+"
## rex.match_case
"ABC" regexMatch "abc"
## rex.match_icase
"ABC" regexMatch "abc/i"
## rex.find
"one 2 three 45" regexFind ["[0-9]+"]
## rex.find_offset
"one 2 three 45" regexFind ["[0-9]+", 6]
## rex.find_groups
"key=value; a=b" regexFind ["(\w+)=(\w+)"]
## rex.find_none
"abc" regexFind ["[0-9]"]
## rex.replace_global
"wookie boOkie cookie" regexReplace [".oo/gio", "[$&]"]
## rex.replace_first
"aaa" regexReplace ["a", "b"]
## rex.replace_all
"aaa" regexReplace ["a/g", "b"]
## rex.replace_group
"2024-06-01" regexReplace ["(\d+)-(\d+)-(\d+)/g", "$3.$2.$1"]
## rex.bad_pattern
"abc" regexMatch "("
## rex.utf8
"héllo" regexReplace ["é/g", "e"]
## rex.find_unicode_offsets
"éa1" regexFind ["[0-9]"]
