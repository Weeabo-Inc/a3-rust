// Common BIS_fnc_* helpers from the function library (world-independent).
## bis.sortnum
[3, 1, 2] call BIS_fnc_sortNum
## bis.sortby
[[3, 1, 2], [], {_x}, "ASCEND"] call BIS_fnc_sortBy
## bis.sortby_desc
[[3, 1, 2], [], {_x}, "DESCEND"] call BIS_fnc_sortBy
## bis.sortalphabetically
["b", "C", "a"] call BIS_fnc_sortAlphabetically
## bis.arraypushstack
[[1, 2], [3, 4]] call BIS_fnc_arrayPushStack
## bis.arrayshift
private _a = [1, 2, 3]; [_a call BIS_fnc_arrayShift, _a]
## bis.arraypop
private _a = [1, 2, 3]; [_a call BIS_fnc_arrayPop, _a]
## bis.removeindex
[[1, 2, 3, 4], 1] call BIS_fnc_removeIndex
## bis.removeindex_range
[[1, 2, 3, 4, 5], 1, 3] call BIS_fnc_removeIndex
## bis.subselect
[[1, 2, 3, 4], 1, 2] call BIS_fnc_subSelect
## bis.consolidatearray
["a", "b", "a", "c", "a"] call BIS_fnc_consolidateArray
## bis.findnestedelement
[[1, [2, [3]]], 3] call BIS_fnc_findNestedElement
## bis.arraycompare
[[1, 2], [1, 2]] call BIS_fnc_arrayCompare
## bis.removedupes
[1, 2, 1, 3, 2] call BIS_fnc_arrayUnShift
## bis.crossproduct
[[1, 0, 0], [0, 1, 0]] call BIS_fnc_crossProduct
## bis.dotproduct
[[1, 2, 3], [4, 5, 6]] call BIS_fnc_dotProduct
## bis.vectoradd
[[1, 2, 3], [4, 5, 6]] call BIS_fnc_vectorAdd
## bis.vectormultiply
[[1, 2, 3], 2] call BIS_fnc_vectorMultiply
## bis.magnitude
[3, 4, 0] call BIS_fnc_magnitude
## bis.dirto
[[0, 0, 0], [1, 1, 0]] call BIS_fnc_dirTo
## bis.relpos
[[0, 0, 0], 10, 90] call BIS_fnc_relPos
## bis.distance2d
[[0, 0, 0], [3, 4, 5]] call BIS_fnc_distance2D
## bis.round
[3.14159, 2] call BIS_fnc_roundNum
## bis.cuttext
[1.23456, 2] call BIS_fnc_cutDecimals
## bis.numbertext
1234567 call BIS_fnc_numberText
## bis.numberdigits
1234 call BIS_fnc_numberDigits
## bis.timetostring
[3725, "HH:MM:SS"] call BIS_fnc_secondsToString
## bis.timetostring_default
125.5 call BIS_fnc_secondsToString
## bis.parsenumber
"512 + 0x2F" call BIS_fnc_parseNumber
## bis.lowestnum
[5, 2, 9] call BIS_fnc_lowestNum
## bis.greatestnum
[5, 2, 9] call BIS_fnc_greatestNum
## bis.findextreme
[[5, 2, 9], 1] call BIS_fnc_findExtreme
## bis.arithmeticmean
[1, 2, 3, 4] call BIS_fnc_arithmeticMean
## bis.geometricmean
[1, 2, 4] call BIS_fnc_geometricMean
## bis.splitstring
["a-b-c", "-"] call BIS_fnc_splitString
## bis.trimstring
"  pad  " call BIS_fnc_trimString
## bis.filterstring
["a1b2c3", "0123456789"] call BIS_fnc_filterString
## bis.inString
["bc", "abcd"] call BIS_fnc_inString
## bis.inString_case
["BC", "abcd", true] call BIS_fnc_inString
## bis.colorrgbtohtml
[1, 0.5, 0, 1] call BIS_fnc_colorRGBtoHTML
## bis.colorrgbatotexture
[1, 0, 0, 1] call BIS_fnc_colorRGBAtoTexture
## bis.typetext
[1, "a", [], true] apply {_x call BIS_fnc_typeText2}
## bis.sidecolor
west call BIS_fnc_sideColor
## bis.sidename
west call BIS_fnc_sideName
## bis.sidetype
[west, east, resistance, civilian] apply {_x call BIS_fnc_sideID}
## bis.sideid_reverse
[0, 1, 2, 3] apply {_x call BIS_fnc_sideType}
## bis.getcfgdata
(configFile >> "CfgVehicles" >> "B_Soldier_F" >> "cost") call BIS_fnc_getCfgData
## bis.getcfgdataarray
[(configFile >> "CfgVehicles" >> "B_Soldier_F" >> "weapons")] call BIS_fnc_getCfgDataArray
## bis.getcfgisclass
[configFile >> "CfgVehicles" >> "B_Soldier_F"] call BIS_fnc_getCfgIsClass
## bis.getcfgsubclasses
count ((configFile >> "CfgWeapons" >> "arifle_MX_F") call BIS_fnc_getCfgSubClasses)
## bis.displayname
getText (configFile >> "CfgWeapons" >> "arifle_MX_F" >> "displayName")
## bis.baseweapon
"arifle_MX_ACO_pointer_F" call BIS_fnc_baseWeapon
## bis.itemtype_weapon
"arifle_MX_F" call BIS_fnc_itemType
## bis.itemtype_magazine
"30Rnd_65x39_caseless_mag" call BIS_fnc_itemType
## bis.itemtype_item
"ItemMap" call BIS_fnc_itemType
## bis.itemtype_uniform
"U_B_CombatUniform_mcam" call BIS_fnc_itemType
## bis.objecttype
"B_Soldier_F" call BIS_fnc_objectType
## bis.isinfrontof
[[0, 0, 0], 0, [0, 10, 0]] call BIS_fnc_isInFrontOf
## bis.nearestposition
[[[10, 0, 0], [1, 1, 0], [5, 5, 0]], [0, 0, 0]] call BIS_fnc_nearestPosition
## bis.randomint_seeded
typeName ([1, 10] call BIS_fnc_randomInt)
## bis.arraytostr
str ([1, 2, 3] joinString ", ")
## bis.cyclic
typeName BIS_fnc_MP
## bis.fnc_exists
[!isNil "BIS_fnc_sortBy", !isNil "BIS_fnc_a3ro_missing"]
## bis.fnc_typename
typeName BIS_fnc_sortBy
## bis.paramsfnc_ok
[1, 2] call {[_this, 1, 0] call BIS_fnc_param}
## bis.fnc_ifelse_select
[1, 2] select (true)
## bis.weaponcomponents
"arifle_MX_ACO_pointer_F" call BIS_fnc_weaponComponents
## bis.compatibleitems
count ("arifle_MX_F" call BIS_fnc_compatibleItems)
## bis.compatiblemagazines
"arifle_MX_F" call BIS_fnc_compatibleMagazines
## bis.ordinal
[1, 2, 3, 11, 22] apply {_x call BIS_fnc_ordinalNumber}
## bis.romannumeral
[4, 9, 14, 1999] apply {_x call BIS_fnc_romanNumeral}
## bis.mapsize
typeName BIS_fnc_mapSize
## bis.encodeflags
[[true, false, true]] call BIS_fnc_encodeFlags4
