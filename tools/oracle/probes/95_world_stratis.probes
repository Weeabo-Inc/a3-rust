private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; _v setDir 370; private _r = getDir _v; deleteVehicle _v; _r
## wstr.setdir_neg
private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; _v setDir -90; private _r = getDir _v; deleteVehicle _v; _r
## wstr.setdir_vectordir
private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; _v setDir 90; private _r = vectorDir _v; deleteVehicle _v; _r
## wstr.setdir_vectorup
private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; _v setDir 45; private _r = vectorUp _v; deleteVehicle _v; _r
