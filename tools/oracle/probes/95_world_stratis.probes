private _v = createVehicle ["B_MRAP_01_F", [4300, 3800, 0], [], 0, "CAN_COLLIDE"]; private _r = [_v isKindOf "Car", _v isKindOf "LandVehicle", _v isKindOf "Tank", _v isKindOf "MRAP_01_base_F"]; deleteVehicle _v; _r
