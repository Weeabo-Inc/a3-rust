## wstr.setpos_getpos
private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; _v setPos [3510, 4510, 1]; private _r = [getPos _v, getPosATL _v]; deleteVehicle _v; _r
## wstr.getdir_between
private _a = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; private _b = createVehicle ["Land_CargoBox_V1_F", [3510, 4490, 0], [], 0, "CAN_COLLIDE"]; private _r = [_a getDir _b, _a distance _b, _a distance2D _b]; deleteVehicle _a; deleteVehicle _b; _r
## wstr.modeltoworld
private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; _v setDir 90; private _r = _v modelToWorld [1, 2, 0]; deleteVehicle _v; _r
## wstr.worldtomodel
private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; _v setDir 90; private _r = _v worldToModel [3501, 4502, 0]; deleteVehicle _v; _r
## wstr.nearestobjects_types
(nearestObjects [[2950, 6050, 0], ["House"], 40]) apply {typeOf _x}
## wstr.nearestobjects_count
count nearestObjects [[2950, 6050, 0], [], 60]
## wstr.nearestobjects_order_dist
private _p = [2950, 6050, 0]; (nearestObjects [_p, ["House"], 60]) apply {round (_x distance2D _p)}
## wstr.nearestobjects_2d
count nearestObjects [[2950, 6050, 0], ["House"], 60, true]
## wstr.nearobjects_count
count ([2950, 6050, 0] nearObjects 50)
## wstr.nearestobject_type
typeOf nearestObject [2950, 6050, 0]
## wstr.nearestterrainobjects_tree
count nearestTerrainObjects [[3500, 4500, 0], ["TREE"], 50]
## wstr.nearestterrainobjects_house
count nearestTerrainObjects [[2950, 6050, 0], ["HOUSE"], 60]
## wstr.nearestterrainobjects_all
count nearestTerrainObjects [[2950, 6050, 0], [], 30]
## wstr.nearestbuilding
typeOf nearestBuilding [2950, 6050, 0]
## wstr.lis_ground
private _h = lineIntersectsSurfaces [[3500, 4500, 1000], [3500, 4500, -100]]; if (count _h == 0) then {[]} else {(_h select 0) select 0}
## wstr.lis_ground_normal
private _h = lineIntersectsSurfaces [[3500, 4500, 1000], [3500, 4500, -100]]; if (count _h == 0) then {[]} else {(_h select 0) select 1}
## wstr.lis_count_town
count lineIntersectsSurfaces [[2950, 6050, 500], [2950, 6050, -10], objNull, objNull, true, -1]
## wstr.lis_sea
private _h = lineIntersectsSurfaces [[500, 500, 100], [500, 500, -500]]; if (count _h == 0) then {[]} else {(_h select 0) select 0}
## wstr.terrainintersect
terrainIntersect [[3400, 4400, 300], [3600, 4600, 300]]
## wstr.terrainintersectasl
terrainIntersectASL [[3400, 4400, 300], [3600, 4600, 300]]
## wstr.lineintersects
lineIntersects [[3500, 4500, 500], [3500, 4500, 400]]
## wstr.creategroup_side
private _g = createGroup west; private _r = [side _g, str side _g, count units _g]; deleteGroup _g; _r
## wstr.creategroup_id
private _g = createGroup east; private _r = typeName groupId _g; deleteGroup _g; _r
## wstr.createunit_side
private _g = createGroup west; private _u = _g createUnit ["B_Soldier_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; private _r = [side _u, side group _u, typeOf _u, count units _g, leader _g == _u]; deleteVehicle _u; deleteGroup _g; _r
## wstr.createunit_pos
private _g = createGroup west; private _u = _g createUnit ["B_Soldier_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; private _r = getPosATL _u; deleteVehicle _u; deleteGroup _g; _r
## wstr.createunit_east_in_west
private _g = createGroup west; private _u = _g createUnit ["O_Soldier_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; private _r = [side _u, side group _u]; deleteVehicle _u; deleteGroup _g; _r
## wstr.empty_vehicle_side
private _v = createVehicle ["B_MRAP_01_F", [4300, 3800, 0], [], 0, "CAN_COLLIDE"]; private _r = [side _v, str side _v]; deleteVehicle _v; _r
## wstr.getfriend
[west getFriend east, west getFriend resistance, resistance getFriend west, civilian getFriend west, west getFriend west]
## wstr.alive_damage
private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; private _r = [alive _v, damage _v]; deleteVehicle _v; _r
