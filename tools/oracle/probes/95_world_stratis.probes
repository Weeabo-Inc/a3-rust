// World probes on Stratis: terrain heights, water, surfaces, object placement and queries.
@world Stratis
## wstr.worldname
worldName
## wstr.worldsize
worldSize
## wstr.height_center
getTerrainHeightASL [4096, 4096]
## wstr.height_agia_marina
getTerrainHeightASL [2950, 6050]
## wstr.height_airfield
getTerrainHeightASL [1900, 5700]
## wstr.height_mike26
getTerrainHeightASL [4300, 3800]
## wstr.height_kamino
getTerrainHeightASL [6250, 5300]
## wstr.height_girna
getTerrainHeightASL [2000, 2700]
## wstr.height_hill
getTerrainHeightASL [3500, 4500]
## wstr.height_fraction
getTerrainHeightASL [3501.37, 4499.81]
## wstr.height_cell_corner
getTerrainHeightASL [3500, 4496]
## wstr.height_cell_mid
getTerrainHeightASL [3502, 4498]
## wstr.height_sea
getTerrainHeightASL [500, 500]
## wstr.height_outside_neg
getTerrainHeightASL [-100, -100]
## wstr.height_outside_far
getTerrainHeightASL [9000, 9000]
## wstr.height_3d_arg
getTerrainHeightASL [3500, 4500, 1000]
## wstr.height_grid
private _r = []; for "_x" from 1000 to 7000 step 1500 do { for "_y" from 1000 to 7000 step 1500 do { _r pushBack (getTerrainHeightASL [_x, _y]) } }; _r
## wstr.height_grid_fine
private _r = []; for "_i" from 0 to 15 do { _r pushBack (getTerrainHeightASL [3000 + _i * 0.7, 6000 + _i * 1.3]) }; _r
## wstr.water_sea
surfaceIsWater [500, 500]
## wstr.water_land
surfaceIsWater [4300, 3800]
## wstr.water_shore_grid
private _r = []; for "_x" from 1500 to 2500 step 100 do { _r pushBack (surfaceIsWater [_x, 5000]) }; _r
## wstr.surfacetype_land
surfaceType [4300, 3800]
## wstr.surfacetype_sea
surfaceType [500, 500]
## wstr.surfacetype_town
surfaceType [2950, 6050]
## wstr.surfacenormal
surfaceNormal [3500, 4500]
## wstr.asl_to_agl
ASLToAGL [3500, 4500, 300]
## wstr.agl_to_asl
AGLToASL [3500, 4500, 0]
## wstr.atl_to_asl
ATLToASL [3500, 4500, 2]
## wstr.asl_to_atl
ASLToATL [3500, 4500, 300]
## wstr.create_box_atl
private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; private _r = getPosATL _v; deleteVehicle _v; _r
## wstr.create_box_asl
private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; private _r = getPosASL _v; deleteVehicle _v; _r
## wstr.create_box_getpos
private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "CAN_COLLIDE"]; private _r = getPos _v; deleteVehicle _v; _r
## wstr.create_box_height_param
private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 5], [], 0, "CAN_COLLIDE"]; private _r = getPosATL _v; deleteVehicle _v; _r
## wstr.create_box_none
private _v = createVehicle ["Land_CargoBox_V1_F", [3500, 4500, 0], [], 0, "NONE"]; private _r = getPosATL _v; deleteVehicle _v; _r
// getPos over the sea follows the waves, so it is left out.
## wstr.create_box_sea
private _v = createVehicle ["Land_CargoBox_V1_F", [500, 500, 0], [], 0, "CAN_COLLIDE"]; private _r = [getPosATL _v, getPosASL _v]; deleteVehicle _v; _r
## wstr.create_old_syntax
private _v = "Land_CargoBox_V1_F" createVehicle [3600, 4600, 0]; private _r = getPosATL _v; deleteVehicle _v; _r
## wstr.create_car_atl
private _v = createVehicle ["B_MRAP_01_F", [4300, 3800, 0], [], 0, "CAN_COLLIDE"]; private _r = getPosATL _v; deleteVehicle _v; _r
## wstr.create_car_dir_default
private _v = createVehicle ["B_MRAP_01_F", [4300, 3800, 0], [], 0, "CAN_COLLIDE"]; private _r = getDir _v; deleteVehicle _v; _r
## wstr.typeof
private _v = createVehicle ["B_MRAP_01_F", [4300, 3800, 0], [], 0, "CAN_COLLIDE"]; private _r = typeOf _v; deleteVehicle _v; _r
