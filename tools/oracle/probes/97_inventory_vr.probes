private _u = (createGroup west) createUnit ["B_Soldier_F", [100, 100, 0], [], 0, "CAN_COLLIDE"]; private _r = [primaryWeapon _u, secondaryWeapon _u, handgunWeapon _u, binocular _u, uniform _u, vest _u, backpack _u, headgear _u, goggles _u]; deleteVehicle _u; _r
