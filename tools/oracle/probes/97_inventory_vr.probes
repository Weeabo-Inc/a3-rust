// Unit inventory: the default loadout of a rifleman, and how the gear commands change it.
// Every probe makes its own unit and deletes it.
@world VR
## inv.default_weapons
private _u = (createGroup west) createUnit ["B_Soldier_F", [100, 100, 0], [], 0, "CAN_COLLIDE"]; private _r = weapons _u; deleteVehicle _u; _r
