private _u = (createGroup west) createUnit ["B_Soldier_F", [100, 100, 0], [], 0, "CAN_COLLIDE"]; for "_i" from 1 to 60 do { _u addItem "FirstAidKit" }; private _r = [count uniformItems _u, count vestItems _u, count items _u]; deleteVehicle _u; _r
