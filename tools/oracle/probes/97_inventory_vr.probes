## inv.add_item_capacity
private _u = (createGroup west) createUnit ["B_Soldier_F", [100, 100, 0], [], 0, "CAN_COLLIDE"]; removeAllItems _u; removeAllItemsWithMagazines _u; private _n = 0; for "_i" from 1 to 40 do { _u addItemToUniform "FirstAidKit" }; private _r = [count uniformItems _u, loadUniform _u]; deleteVehicle _u; _r
